		"scrollbarSlider.background": "#8B5CF644",
		"scrollbarSlider.hoverBackground": "#A78BFA77"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8B78A0", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": { "foreground": "#C084FC" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#A7F3D0" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#F9A8D4" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#93C5FD" }
		},
		{
			"scope": ["entity.name.type", "support.type", "support.class"],
			"settings": { "foreground": "#FDE68A" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name"],
			"settings": { "foreground": "#E9D5FF" }
		}
	]
}
